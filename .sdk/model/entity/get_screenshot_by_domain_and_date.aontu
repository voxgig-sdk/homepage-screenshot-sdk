# Entity: get_screenshot_by_domain_and_date

main: kit: entity: get_screenshot_by_domain_and_date: {

  alias: field: {}

  fields: {
    date: {
      h: "Date"
      n: "date"
      r: false
      sh: "The date of the screenshot in YYYY-MM format"
      t: "`$STRING`"
    }
    domain: {
      h: "Domain"
      n: "domain"
      r: false
      sh: "The requested domain"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    screenshot_url: {
      h: "Screenshot Url"
      n: "screenshot_url"
      r: false
      sh: "URL to the screenshot image"
      t: "`$STRING`"
    }
    size: {
      h: "Size"
      n: "size"
      r: false
      sh: "Size of the screenshot"
      t: "`$INTEGER`"
    }
    timestamp: {
      h: "Timestamp"
      n: "timestamp"
      r: false
      sh: "When the screenshot was taken"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    from: {
      date: "date"
      domain: "domain"
    }
    name: "id"
    parts: [
      "domain"
      "date"
    ]
    sep: "/"
  }

  name: "get_screenshot_by_domain_and_date"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /{domain}/{date}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "2026-02"
                k: "param"
                n: "date"
                or: "date"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "bbc.co.uk"
                k: "param"
                n: "domain"
                or: "domain"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "png"
                k: "query"
                n: "f"
                or: "f"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 2048
                k: "query"
                n: "s"
                or: "s"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/{domain}/{date}"
          q: {
            exist: [
              "date"
              "domain"
              "f"
              "s"
            ]
          }
          s: [
            {
              var: "domain"
            }
            {
              var: "date"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
