# Entity: get_screenshot_by_domain_and_date

main: kit: entity: get_screenshot_by_domain_and_date: {

  alias: field: {}

  fields: [
    {
      name: "date"
      req: false
      short: "The date of the screenshot in YYYY-MM format"
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: false
      short: "The requested domain"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "screenshot_url"
      req: false
      short: "URL to the screenshot image"
      type: "`$STRING`"
    }
    {
      name: "size"
      req: false
      short: "Size of the screenshot"
      type: "`$INTEGER`"
    }
    {
      name: "timestamp"
      req: false
      short: "When the screenshot was taken"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    from: {
      date: "date"
      domain: "domain"
    }
    name: "id"
    parts: [
      "domain"
      "date"
    ]
    sep: "/"
  }

  name: "get_screenshot_by_domain_and_date"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "2026-02"
                kind: "param"
                name: "date"
                orig: "date"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "bbc.co.uk"
                kind: "param"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "png"
                kind: "query"
                name: "f"
                orig: "f"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 2048
                kind: "query"
                name: "s"
                orig: "s"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /{domain}/{date}"
            json: "{\"operationId\":\"getScreenshotByDomainAndDate\",\"parameters\":[{\"description\":\"The domain name to capture (e.g., bbc.co.uk)\",\"in\":\"path\",\"name\":\"domain\",\"required\":true,\"schema\":{\"example\":\"bbc.co.uk\",\"type\":\"string\"}},{\"description\":\"Date in YYYY-MM format (e.g., 2024-01, 2026-02)\",\"in\":\"path\",\"name\":\"date\",\"required\":true,\"schema\":{\"example\":\"2026-02\",\"pattern\":\"^\\\\d{4}-(0[1-9]|1[0-2])$\",\"type\":\"string\"}},{\"description\":\"Size of the screenshot in pixels (width)\",\"in\":\"query\",\"name\":\"s\",\"required\":false,\"schema\":{\"default\":2048,\"enum\":[128,256,512,2048],\"type\":\"integer\"}},{\"description\":\"Format of the response\",\"in\":\"query\",\"name\":\"f\",\"required\":false,\"schema\":{\"default\":\"png\",\"enum\":[\"png\",\"md\",\"json\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"date\":{\"description\":\"The date of the screenshot in YYYY-MM format\",\"type\":\"string\"},\"domain\":{\"description\":\"The requested domain\",\"type\":\"string\"},\"screenshot_url\":{\"description\":\"URL to the screenshot image\",\"type\":\"string\"},\"size\":{\"description\":\"Size of the screenshot\",\"type\":\"integer\"},\"timestamp\":{\"description\":\"When the screenshot was taken\",\"type\":\"string\"}},\"type\":\"object\"}},\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}},\"text/markdown\":{\"schema\":{\"description\":\"Markdown representation of the screenshot information\",\"type\":\"string\"}}},\"description\":\"Successful response with screenshot from the specified date\"},\"404\":{\"description\":\"Domain not found or screenshot not available for the specified date\"},\"429\":{\"description\":\"Rate limit exceeded (1,000 requests per day without API key)\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/{domain}/{date}"
          segments: [
            {
              var: "domain"
            }
            {
              var: "date"
            }
          ]
          select: {
            exist: [
              "date"
              "domain"
              "f"
              "s"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
